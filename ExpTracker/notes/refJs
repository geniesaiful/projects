var myForm = document.getElementById("mixedDataForm");
var listContainer = document.getElementById("outputList");

// Show items on load
showSavedItems();

// Form Submit Handler
myForm.addEventListener("submit", function(event) {
  event.preventDefault();

  var selectedCategory = document.getElementById("category").value;
  var selectedStatus = document.getElementById("status").value;
  var writtenNotes = document.getElementById("notes").value;
  var numericAmount = parseFloat(document.getElementById("amount").value);
  var dateText = document.getElementById("eventTime").value;

  // Simple Math: Add 15% tax
  var taxCalculation = numericAmount * 0.15;
  var finalTotal = numericAmount + taxCalculation;

  var newItem = {
    category: selectedCategory,
    status: selectedStatus,
    notes: writtenNotes,
    amount: numericAmount,
    calculatedTotal: finalTotal,
    time: dateText
  };

  var savedList = localStorage.getItem("allFormEntries");
  var itemArray = [];

  if (savedList !== null) {
    itemArray = JSON.parse(savedList);
  }

  var editingPosition = document.getElementById("editIndex").value;

  if (editingPosition !== "") {
    var positionNumber = parseInt(editingPosition);
    itemArray[positionNumber] = newItem;
  } else {
    itemArray.push(newItem);
  }

  localStorage.setItem("allFormEntries", JSON.stringify(itemArray));

  clearForm();
  showSavedItems();
});

// MODIFIED: Displays items and applies search/filter adjustments on the fly
function showSavedItems() {
  var savedList = localStorage.getItem("allFormEntries");
  var itemArray = [];

  if (savedList !== null) {
    itemArray = JSON.parse(savedList);
  }

  // 1. Read current text filter values from the screen controls
  var searchText = document.getElementById("searchBox").value.toLowerCase();
  var chosenFilterCategory = document.getElementById("filterCategory").value;

  // Clear previous output list completely
  listContainer.innerHTML = "";

  // 2. Loop through every single item in our master array list
  for (var i = 0; i < itemArray.length; i++) {
    var item = itemArray[i];

    // Check criteria A: Does the category match the filter option dropdown selection?
    var categoryMatches = (chosenFilterCategory === "ALL" || item.category === chosenFilterCategory);
    
    // Check criteria B: Do the written notes contain the text typed in the search bar?
    var notesMatch = item.notes.toLowerCase().includes(searchText);

    // 3. Only draw the item box on screen if it passes both tests successfully
    if (categoryMatches && notesMatch) {
      var itemBox = document.createElement("div");
      itemBox.style.border = "1px solid #ccc";
      itemBox.style.padding = "10px";
      itemBox.style.margin = "10px 0";

      itemBox.innerHTML = 
        "<p><b>Category:</b> " + item.category + " | <b>Status:</b> " + item.status + "</p>" +
        "<p><b>Notes:</b> " + item.notes + "</p>" +
        "<p><b>Original Price:</b> $" + item.amount + " | <b>Calculated Total (+15% Tax):</b> $" + item.calculatedTotal.toFixed(2) + "</p>" +
        "<p><b>Date Chosen:</b> " + item.time + "</p>" +
        // Pass "i" directly so the system retains correct array indexes during actions
        "<button onclick='prepareEdit(" + i + ")'>Edit This</button> " + 
        "<button onclick='deleteItem(" + i + ")'>Delete This</button>";

      listContainer.appendChild(itemBox);
    }
  }
}

// Edit Action Function
function prepareEdit(indexPosition) {
  var savedList = localStorage.getItem("allFormEntries");
  var itemArray = JSON.parse(savedList);
  var targetItem = itemArray[indexPosition];

  document.getElementById("category").value = targetItem.category;
  document.getElementById("status").value = targetItem.status;
  document.getElementById("notes").value = targetItem.notes;
  document.getElementById("amount").value = targetItem.amount;
  document.getElementById("eventTime").value = targetItem.time;

  document.getElementById("editIndex").value = indexPosition;

  document.getElementById("submitBtn").innerText = "Update Item Changes";
  document.getElementById("cancelBtn").style.display = "inline-block";
}

// Delete Action Function
function deleteItem(indexPosition) {
  var userConfirmed = confirm("Do you want to delete this specific entry?");
  
  if (userConfirmed === true) {
    var savedList = localStorage.getItem("allFormEntries");
    var itemArray = JSON.parse(savedList);

    itemArray.splice(indexPosition, 1);
    localStorage.setItem("allFormEntries", JSON.stringify(itemArray));
    
    clearForm();
    showSavedItems();
  }
}

// Reset form elements to normal state
function clearForm() {
  myForm.reset();
  document.getElementById("editIndex").value = "";
  document.getElementById("submitBtn").innerText = "Save Item";
  document.getElementById("cancelBtn").style.display = "none";
}
